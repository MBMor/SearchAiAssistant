<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SearchAiAssistant.Api\SearchAiAssistant.Api.csproj" />
